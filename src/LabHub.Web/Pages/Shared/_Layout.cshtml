@inject LabHub.Web.Core.ContentStore Store
@{
    var currentPath = ViewData["CurrentPath"] as string ?? "";
    var roots = Store.Current.Roots;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string title ? $"{title} — LabHub" : "LabHub")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" href="/">Lab<span>Hub</span></a>
            <nav class="site-nav">
                <a href="/">Курсы</a>
            </nav>
        </div>
    </header>
    <div class="container layout">
        @if (roots.Count > 0)
        {
            <aside class="sidebar">
                <nav class="tree" aria-label="Материалы">
                    <ul class="tree-list tree-root">
                        @foreach (var root in roots)
                        {
                            <partial name="_TreeNode" model="new TreeNodeView(root, currentPath)" />
                        }
                    </ul>
                </nav>
            </aside>
        }
        <main class="page-main">
            @RenderBody()
        </main>
    </div>
    <footer class="site-footer">
        <div class="container">LabHub — лабораторные и материалы курсов</div>
    </footer>
</body>
</html>
