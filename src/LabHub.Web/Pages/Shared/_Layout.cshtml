@inject LabHub.Web.Core.ContentStore Store
@{
    var currentPath = ViewData["CurrentPath"] as string ?? "";
    var roots = Store.Current.Roots;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string title ? $"{title} — LabHub" : "LabHub")</title>
    <meta name="description" content="LabHub — практичні роботи та матеріали курсів" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/katex/katex.min.css" asp-append-version="true" />
    <script defer src="~/lib/katex/katex.min.js" asp-append-version="true"></script>
    <script defer src="~/js/math.js" asp-append-version="true"></script>
</head>
<body>
    <header class="site-header">
        <div class="header-inner">
            <a class="brand" href="/">Lab<span>Hub</span></a>
            <nav class="site-nav">
                <a href="/">Матеріали</a>
            </nav>
        </div>
    </header>
    <div class="layout">
        @if (roots.Count > 0)
        {
            <aside class="sidebar">
                <nav class="tree" aria-label="Материалы">
                    <ul class="tree-list tree-root">
                        @foreach (var root in roots)
                        {
                            <partial name="_TreeNode" model="new TreeNodeView(root, currentPath)" />
                        }
                    </ul>
                </nav>
            </aside>
        }
        <main class="page-main">
            <div class="content-wrap">
                @RenderBody()
            </div>
        </main>
    </div>
    <footer class="site-footer">
        <div class="footer-inner">LabHub — практичні роботи та матеріали курсів</div>
    </footer>
</body>
</html>
