@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

@if (!Model.HasContent)
{
    <p class="empty-state">Контент пока не загружен — загляните чуть позже.</p>
}
else
{
    <div class="hero">
        <h1>Лабораторные и материалы курсов</h1>
        <p class="hero-lead">
            Все курсы, статьи и лабораторные — в меню слева.
            Выберите курс, раскройте раздел и работайте по порядку:
            у каждой лабы есть цель, ход работы и контрольные вопросы.
        </p>
        <p class="hero-hint">
            В некоторых лабах есть экстра-задания по трекам — выбирайте тот,
            что ближе к вашему будущему направлению.
        </p>
    </div>
}
