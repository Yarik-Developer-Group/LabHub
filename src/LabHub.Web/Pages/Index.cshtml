@page
@model IndexModel
@{
    ViewData["Title"] = "Головна";
}

@if (!Model.HasContent)
{
    <p class="empty-state">Контент ще не завантажено — загляньте трохи пізніше.</p>
}
else
{
    <div class="hero">
        <h1>Практичні роботи та матеріали курсів</h1>
        <p class="hero-lead">
            Усі курси, теорія та практичні роботи — в меню зліва.
            Оберіть курс, розгорніть розділ і працюйте послідовно:
            кожна робота спирається на попередню.
        </p>
        <p class="hero-hint">
            Перед першою практичною роботою оберіть свій варіант —
            правила вибору описані у відповідному розділі курсу.
        </p>
    </div>
}
