<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Markdig вендорен исходниками (third_party/Markdig, BSD-2-Clause):
         сборка не зависит от доступности NuGet. -->
    <ProjectReference Include="..\..\third_party\Markdig\Markdig.csproj" />
  </ItemGroup>

  <!-- Контент едет в выходной пакет вместе с приложением: /content рядом с кодом. -->
  <ItemGroup>
    <Content Include="..\..\content\**" LinkBase="content\" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
